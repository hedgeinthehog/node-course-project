# Runtime mode: development | test | production (default: development)
NODE_ENV=development

# HTTP port the API listens on (default: 3000)
PORT=3000

# Connection URL of PgBouncer (not Postgres directly) WITHOUT credentials; user and password come from DB_PASSWORD_FILE
DB_URL=postgres://localhost:6432/marketplace

# Path to the secret file with "user:password" for Postgres (never committed, rotated by rotate.sh)
DB_PASSWORD_FILE=secrets/db_password

# AMQP URL of RabbitMQ with credentials (the compose dev user is not a secret; production value comes from the vault)
BROKER_URL=amqp://marketplace:marketplace_dev@localhost:5672

# Redis for the cache (allkeys-lru + maxmemory): product cards, nothing that must survive eviction
REDIS_URL=redis://localhost:6379

# Redis for state that must not be evicted (noeviction + AOF): BullMQ queue, sessions, rate-limit counters
REDIS_QUEUE_URL=redis://localhost:6382

# Requests per client allowed in one sliding window (default: 100)
RATE_LIMIT=100

# Sliding window of the rate limit in milliseconds (default: 10000)
RATE_LIMIT_WINDOW_MS=10000

# S3-compatible object storage: MinIO from compose locally; an empty endpoint means AWS S3 itself
STORAGE_ENDPOINT=http://localhost:9000

# Region used for SigV4 signing (MinIO ignores it, AWS needs the bucket's region)
STORAGE_REGION=us-east-1

# Access key / secret of the storage user (the compose dev root user is not a secret; production keys come from the vault)
STORAGE_ACCESS_KEY=marketplace
STORAGE_SECRET_KEY=marketplace_dev

# Private bucket for uploads and hashed public assets, created by `npm run storage:init`
STORAGE_BUCKET=marketplace-files

# Pact Broker for contract tests; read only by test tooling (local compose broker: http://127.0.0.1:9292)
PACT_BROKER_URL=http://127.0.0.1:9292

# Pact Broker bearer token; empty for the local compose broker, a real value lives in the vault / CI secrets
PACT_BROKER_TOKEN=

# Auth (vault only, no defaults): kid of the signing key, its base64-encoded PEM private key (ES256),
# the verification keyring "kid:base64pem,kid:base64pem" (must include JWT_KID; old and new key during rotation),
# HMAC pepper for refresh-token hashes. Generate a dev pair with: node scripts/jwt-keys.mjs >> .env
JWT_KID=dev
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEYS=
REFRESH_TOKEN_PEPPER=
