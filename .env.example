# Runtime mode: development | test | production (default: development)
NODE_ENV=development

# HTTP port the API listens on (default: 3000)
PORT=3000

# Postgres connection URL WITHOUT a password; the password is read from DB_PASSWORD_FILE
DB_URL=postgres://marketplace@localhost:5433/marketplace

# Path to the file holding the Postgres password (never committed, rotated by rotate.sh)
DB_PASSWORD_FILE=secrets/db_password
