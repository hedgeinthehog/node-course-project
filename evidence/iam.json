{
  "TrustPolicy": {
    "Statement": [
      {
        "Action": "sts:AssumeRoleWithWebIdentity",
        "Condition": {
          "StringEquals": {
            "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
          },
          "StringLike": {
            "token.actions.githubusercontent.com:sub": "repo:hedgeinthehog/node-course-project:*"
          }
        },
        "Effect": "Allow",
        "Principal": {
          "Federated": "arn:aws:iam::000000000000:oidc-provider/token.actions.githubusercontent.com"
        }
      }
    ],
    "Version": "2012-10-17"
  },
  "PermissionPolicy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Action": [
          "rds:DescribeDBInstances",
          "rds:DescribeDBSubnetGroups",
          "rds:ListTagsForResource",
          "rds:DeleteDBInstance",
          "rds:DeleteDBSubnetGroup",
          "elasticloadbalancing:DescribeLoadBalancers",
          "elasticloadbalancing:DescribeLoadBalancerAttributes",
          "elasticloadbalancing:DescribeListeners",
          "elasticloadbalancing:DescribeListenerAttributes",
          "elasticloadbalancing:DescribeTargetGroups",
          "elasticloadbalancing:DescribeTargetGroupAttributes",
          "elasticloadbalancing:DescribeTargetHealth",
          "elasticloadbalancing:DescribeTags",
          "elasticloadbalancing:DeregisterTargets",
          "elasticloadbalancing:DeleteListener",
          "elasticloadbalancing:DeleteTargetGroup",
          "elasticloadbalancing:DeleteLoadBalancer",
          "ec2:DescribeNatGateways",
          "ec2:DescribeAddresses",
          "ec2:DescribeAddressesAttribute",
          "ec2:DescribeTags",
          "ec2:DeleteNatGateway",
          "ec2:DisassociateAddress",
          "ec2:ReleaseAddress",
          "lambda:GetFunction",
          "lambda:GetFunctionCodeSigningConfig",
          "lambda:GetPolicy",
          "lambda:ListVersionsByFunction",
          "lambda:RemovePermission",
          "lambda:DeleteFunction",
          "iam:GetRole",
          "iam:ListRolePolicies",
          "iam:ListAttachedRolePolicies",
          "iam:ListInstanceProfilesForRole",
          "iam:DetachRolePolicy",
          "iam:DeleteRole",
          "tag:GetResources"
        ],
        "Effect": "Allow",
        "Resource": "*",
        "Sid": "DestroyDemoStackAndProveItIsGone"
      }
    ]
  },
  "Role": {
    "Path": "/",
    "RoleName": "hw31-ci-teardown",
    "RoleId": "AROAQAAAAAAAGHWSHPQNP",
    "Arn": "arn:aws:iam::000000000000:role/hw31-ci-teardown",
    "CreateDate": "2026-11-23T06:46:52.512672+00:00",
    "Description": "Assumed by GitHub Actions through OIDC to destroy the demo stack and prove it is gone",
    "MaxSessionDuration": 3600,
    "Tags": [
      {
        "Key": "ManagedBy",
        "Value": "pulumi"
      },
      {
        "Key": "Project",
        "Value": "nodejs-pro-hw31"
      },
      {
        "Key": "Stack",
        "Value": "base"
      }
    ],
    "RoleLastUsed": {}
  }
}
